# 数据库
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
POSTGRES_DB=customer_service
POSTGRES_PORT=5432

# 允许跨域访问后端的前端地址（JSON 数组）。不写时默认允许 localhost:3000 和 127.0.0.1:3000
# FRONTEND_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# 大模型
# fake：内置离线模型，不联网、不需要 Key
# openai_compatible：任何兼容 OpenAI 接口的服务，下面三项必须都填
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
