# 数据库
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
POSTGRES_DB=customer_service
POSTGRES_PORT=5432

# 允许跨域访问后端的前端地址（JSON 数组）。不写时默认允许 localhost:3000 和 127.0.0.1:3000
# FRONTEND_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# 登录令牌的签名密钥，至少 32 个字符。生成方式：
# uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# 登录有效期（分钟），默认 480（8 小时）
# ACCESS_TOKEN_MINUTES=480
# 部署到 HTTPS 后改为 true，Cookie 就只会通过加密连接发送
# COOKIE_SECURE=false

# MCP Server
# 后端调用 MCP Server 时的令牌签名密钥，至少 32 个字符，不能和 JWT_SECRET 相同。生成方式同上
MCP_TOKEN_SECRET=
# 后端和 MCP Server 的地址，默认如下。后端地址是令牌的签发方，MCP 地址是令牌的接收方
# BACKEND_URL=http://localhost:8000
# MCP_SERVER_URL=http://localhost:8001/mcp

# 大模型
# fake：内置离线模型，不联网、不需要 Key，回复按固定规则生成（聊天页会显示“离线演示模式”的说明）
# openai_compatible：任何兼容 OpenAI 接口的服务，下面三项必须都填（本项目没有用真实模型验收过）
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 知识库检索
# keyword：只用关键词检索（默认，已验收）
# hybrid：关键词加 BGE-M3 向量的混合检索。实验功能，验收没有通过，默认关闭；
#         需要另外下载 BGE-M3 模型，并把下面的目录指向它
# RETRIEVAL_MODE=keyword
# EMBEDDING_MODEL_DIR=
